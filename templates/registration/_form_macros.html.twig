{% macro text_field(field, type = 'text', attrs = '') %}
    {% do field.setRendered %}
    <md-outlined-text-field
        class="gab-field"
        label="{{ field.vars.label }}"
        name="{{ field.vars.full_name }}"
        id="{{ field.vars.id }}"
        type="{{ type }}"
        value="{{ field.vars.value }}"
        {{ field.vars.required ? 'required' : '' }}
        {% if field.vars.errors|length > 0 %}error error-text="{{ field.vars.errors|first.message }}"{% endif %}
        {{ attrs|raw }}
    ></md-outlined-text-field>
{% endmacro %}

{% macro select_field(field, attrs = '') %}
    {% do field.setRendered %}
    <md-outlined-select
        class="gab-field"
        label="{{ field.vars.label }}"
        name="{{ field.vars.full_name }}"
        id="{{ field.vars.id }}"
        {{ field.vars.required ? 'required' : '' }}
        {% if field.vars.errors|length > 0 %}error error-text="{{ field.vars.errors|first.message }}"{% endif %}
        {{ attrs|raw }}
    >
        {% for choice in field.vars.choices %}
            <md-select-option value="{{ choice.value }}" {{ choice.value == field.vars.value ? 'selected' : '' }}>
                <div slot="headline">{{ choice.label }}</div>
            </md-select-option>
        {% endfor %}
    </md-outlined-select>
{% endmacro %}

{% macro checkbox_field(field, attrs = '') %}
    {% do field.setRendered %}
    <label class="gab-checkbox-row">
        <md-checkbox
            name="{{ field.vars.full_name }}"
            id="{{ field.vars.id }}"
            value="1"
            {{ field.vars.checked ? 'checked' : '' }}
            {{ attrs|raw }}
        ></md-checkbox>
        <span>{{ field.vars.label }}</span>
    </label>
{% endmacro %}

{% macro radio_group_field(field, attrs = '') %}
    {% do field.setRendered %}
    <fieldset class="gab-radio-group" data-radio-name="{{ field.vars.full_name }}" {{ field.vars.required ? 'data-required="1"' : '' }}>
        <legend>{{ field.vars.label }}{{ field.vars.required ? '*' : '' }}</legend>
        <div class="gab-radio-group__options">
            {% for child in field %}
                {% do child.setRendered %}
                <label class="gab-radio-row">
                    <md-radio
                        name="{{ child.vars.full_name }}"
                        id="{{ child.vars.id }}"
                        value="{{ child.vars.value }}"
                        {{ child.vars.checked ? 'checked' : '' }}
                        {{ attrs|raw }}
                    ></md-radio>
                    <span>{{ child.vars.label }}</span>
                </label>
            {% endfor %}
        </div>
        <p class="gab-field-error" data-radio-error>{% if field.vars.errors|length > 0 %}{{ field.vars.errors|first.message }}{% endif %}</p>
    </fieldset>
{% endmacro %}

{% macro collection_field(field, controller = 'step2', max = 4) %}
    {% do field.setRendered %}
    {% set prototypeHtml %}
        <div class="gab-collection__item" data-{{ controller }}-target="collectionItem">
            {{ _self.text_field(field.vars.prototype) }}
            <button type="button" class="gab-collection__remove" data-action="click->{{ controller }}#removeCollectionItem" aria-label="Supprimer cette ligne">✕</button>
        </div>
    {% endset %}
    <div class="gab-collection"
         data-{{ controller }}-target="collection"
         data-index="{{ field.vars.value|length }}"
         data-max="{{ max }}"
         data-prototype="{{ prototypeHtml|trim|e('html_attr') }}">
        <label class="gab-collection__label">{{ field.vars.label }}</label>
        <div data-{{ controller }}-target="collectionItems">
            {% for item in field %}
                <div class="gab-collection__item" data-{{ controller }}-target="collectionItem">
                    {{ _self.text_field(item) }}
                    <button type="button" class="gab-collection__remove" data-action="click->{{ controller }}#removeCollectionItem" aria-label="Supprimer cette ligne">✕</button>
                </div>
            {% endfor %}
        </div>
        <md-text-button type="button" data-{{ controller }}-target="collectionAddButton" data-action="click->{{ controller }}#addCollectionItem">
            <md-icon slot="icon">add</md-icon>
            Ajouter
        </md-text-button>
    </div>
{% endmacro %}

{% macro file_field(field, accept, stimulusTarget, controller = 'step1') %}
    {% do field.setRendered %}
    <div class="gab-upload"
         data-{{ controller }}-target="{{ stimulusTarget }}Zone"
         data-action="dragover->{{ controller }}#dragOver dragleave->{{ controller }}#dragLeave drop->{{ controller }}#drop">
        <label class="gab-upload__dropzone" for="{{ field.vars.id }}">
            <md-icon>upload_file</md-icon>
            <span class="gab-upload__label">{{ field.vars.label }}</span>
            <span class="gab-upload__hint">PDF, JPEG ou PNG · 5 Mo max</span>
            <span class="gab-upload__filename" data-{{ controller }}-target="{{ stimulusTarget }}Name"></span>
        </label>
        <input
            type="file"
            class="gab-upload__input"
            name="{{ field.vars.full_name }}"
            id="{{ field.vars.id }}"
            accept="{{ accept }}"
            {{ field.vars.required ? 'required' : '' }}
            data-{{ controller }}-target="{{ stimulusTarget }}Input"
            data-action="change->{{ controller }}#previewFileName"
        >
        {% if field.vars.errors|length > 0 %}
            <p class="gab-field-error">{{ field.vars.errors|first.message }}</p>
        {% endif %}
    </div>
{% endmacro %}
