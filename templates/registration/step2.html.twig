{% extends 'base.html.twig' %}

{% block title %}Étape 2 · Recensement diaspora gabonaise{% endblock %}

{% block content %}
    <div class="gab-progress">
        <md-linear-progress value="1" aria-label="Étape 2 sur 2"></md-linear-progress>
        <p class="gab-progress__label">Étape 2 sur 2</p>
    </div>

    <md-outlined-card style="display:block; padding: 24px; border-radius: 16px;">
        <h1>Identité enregistrée</h1>
        <p>
            Merci {{ registrant.firstName }} {{ registrant.lastName }}, votre identité a bien été
            enregistrée pour la session en cours.
        </p>
        <p><em>L'écran 2 (profil étudiant / salarié / entrepreneur) sera construit dans une prochaine étape.</em></p>
    </md-outlined-card>
{% endblock %}
