{% extends 'admin/base.html.twig' %}
{% import 'registration/_form_macros.html.twig' as f %}

{% block title %}Inscrits · Admin{% endblock %}

{% block breadcrumb %}<span>/ Inscrits</span>{% endblock %}

{% block admin_content %}
    <div class="gab-admin-page-header">
        <h1 class="gab-admin-title">Inscrits</h1>
        <p class="gab-admin-subtitle">{{ total }} dossier{{ total > 1 ? 's' : '' }} correspondant{{ total > 1 ? 's' : '' }}</p>
    </div>

    <md-outlined-card class="gab-section gab-filter-card">
        {{ form_start(filterForm, {method: 'GET', attr: {novalidate: 'novalidate'}}) }}
            <div class="gab-grid gab-grid--filters">
                {{ f.text_field(filterForm.search) }}
                {{ f.select_field(filterForm.country) }}
                {{ f.select_field(filterForm.profileType) }}
                {{ f.select_field(filterForm.passportStatus) }}
                {{ f.select_field(filterForm.consularStatus) }}
                {{ f.text_field(filterForm.dateFrom, 'date') }}
                {{ f.text_field(filterForm.dateTo, 'date') }}
            </div>
            <div class="gab-filter-card__actions">
                <a href="{{ path('admin_registrant_index') }}" class="gab-text-link">Réinitialiser</a>
                <md-filled-button type="submit">
                    Filtrer
                    <md-icon slot="icon">filter_alt</md-icon>
                </md-filled-button>
            </div>
            {{ form_rest(filterForm) }}
        {{ form_end(filterForm, {render_rest: false}) }}
    </md-outlined-card>

    <md-outlined-card class="gab-section">
        <div class="gab-table-wrapper">
            <table class="gab-table">
                <thead>
                    <tr>
                        <th>Réf.</th>
                        <th>Nom complet</th>
                        <th>Profil</th>
                        <th>Pays</th>
                        <th>1ère entrée</th>
                        <th>Durée séjour</th>
                        <th>Passeport</th>
                        <th>Carte consul.</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for registrant in registrants %}
                        <tr>
                            <td>{{ registrant.reference }}</td>
                            <td>{{ registrant.lastName }} {{ registrant.firstName }}</td>
                            <td><span class="gab-chip gab-chip--{{ registrant.profileType.value }}">{{ registrant.profileType.value == 'student' ? 'Étudiant' : (registrant.profileType.value == 'employee' ? 'Salarié' : 'Entrepreneur') }}</span></td>
                            <td>{{ registrant.country }}</td>
                            <td>{{ registrant.firstEntryDate|date('d/m/Y') }}</td>
                            <td>{{ registrant.firstEntryDate|stay_duration }}</td>
                            <td>{{ registrant.identityDocument.passportExpiresAt|doc_status_badge|raw }}</td>
                            <td>{{ registrant.identityDocument.consularCardExpiresAt|doc_status_badge|raw }}</td>
                            <td class="gab-table__actions">
                                <a href="{{ path('admin_registrant_show', {id: registrant.id}) }}" class="gab-icon-link" title="Voir la fiche">
                                    <md-icon>visibility</md-icon>
                                </a>
                                <a href="{{ path('admin_registrant_documents', {id: registrant.id}) }}" class="gab-icon-link" title="Télécharger les documents">
                                    <md-icon>download</md-icon>
                                </a>
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="9">Aucun inscrit ne correspond à ces filtres.</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        {% if totalPages > 1 %}
            <nav class="gab-pagination" aria-label="Pagination">
                {% for p in 1..totalPages %}
                    <a
                        href="{{ path('admin_registrant_index', app.request.query.all|merge({page: p})) }}"
                        class="gab-pagination__link {{ p == page ? 'is-active' : '' }}"
                    >{{ p }}</a>
                {% endfor %}
            </nav>
        {% endif %}
    </md-outlined-card>
{% endblock %}
