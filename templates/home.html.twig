{% extends 'base.html.twig' %}

{% block title %}Recensement de la diaspora gabonaise
{% endblock %}

{% block content %}
	<section class="gab-hero" data-controller="hero-slider" data-hero-slider-interval-value="6000">
		<div class="gab-hero__slide is-active" data-hero-slider-target="slide" style="background-image: url('{{ site_image('home_hero_1') }}');" aria-hidden="true"></div>
		<div class="gab-hero__slide" data-hero-slider-target="slide" style="background-image: url('{{ site_image('home_hero_2') }}');" aria-hidden="true"></div>
		<div class="gab-hero__slide" data-hero-slider-target="slide" style="background-image: url('{{ site_image('home_hero_3') }}');" aria-hidden="true"></div>
		<div class="gab-hero__scrim" aria-hidden="true"></div>
		<div class="gab-hero__inner">
			<p class="gab-hero__eyebrow">Bureau Exécutif de l'AGB · Zone Afrique</p>
			<h1 class="gab-hero__title">Recensement de la
				<em>diaspora</em>
				gabonaise</h1>
			<p class="gab-hero__lead">
				Faites-vous connaître auprès du Bureau Exécutif de l'AGB en quelques minutes,
				                où que vous soyez en Zone Afrique.
			</p>
			<md-filled-button href="{{ path('register_step1') }}" style="--md-filled-button-container-color: #009e60;">
				Commencer mon inscription
				<md-icon slot="icon">arrow_forward</md-icon>
			</md-filled-button>
		</div>
		<div class="gab-hero__dots" role="tablist" aria-label="Choisir une photo">
			<button type="button" class="gab-hero__dot is-active" data-hero-slider-target="dot" data-action="hero-slider#goTo" data-hero-slider-index-param="0" role="tab" aria-selected="true" aria-label="Photo 1 sur 3"></button>
			<button type="button" class="gab-hero__dot" data-hero-slider-target="dot" data-action="hero-slider#goTo" data-hero-slider-index-param="1" role="tab" aria-selected="false" aria-label="Photo 2 sur 3"></button>
			<button type="button" class="gab-hero__dot" data-hero-slider-target="dot" data-action="hero-slider#goTo" data-hero-slider-index-param="2" role="tab" aria-selected="false" aria-label="Photo 3 sur 3"></button>
		</div>
	</section>

	<div class="gab-divider gab-divider--primary" aria-hidden="true"></div>

	<section class="gab-showcase">
		<p class="gab-showcase__eyebrow">Le Gabon nous unit</p>
		<h2 class="gab-showcase__title">Une terre, un peuple, une seule voix</h2>
		<p class="gab-showcase__lead">
			Où que vous soyez en zone Afrique, ce recensement vous relie à la communauté
			            gabonaise et à sa terre d'origine.
		</p>

		<div class="gab-showcase__grid">
			<figure class="gab-card">
				<img src="{{ site_image('home_showcase_1') }}" alt="Visite de chantier d'infrastructures au Gabon" loading="lazy">
				<figcaption>
					<span class="gab-card__title">Gabon Développement</span>
					<span class="gab-card__text">Un pays en pleine construction, tourné vers l'avenir.</span>
				</figcaption>
			</figure>
			<figure class="gab-card">
				<img src="{{ site_image('home_showcase_2') }}" alt="Éléphants de forêt dans le Parc national de la Lopé" loading="lazy">
				<figcaption>
					<span class="gab-card__title">Parc de la Lopé</span>
					<span class="gab-card__text">Un patrimoine naturel classé à l'UNESCO.</span>
				</figcaption>
			</figure>
			<figure class="gab-card">
				<img src="{{ site_image('home_showcase_3') }}" alt="Pirogue traditionnelle sur une rivière gabonaise" loading="lazy">
				<figcaption>
					<span class="gab-card__title">Rivières &amp; forêts</span>
					<span class="gab-card__text">Le deuxième poumon vert de la planète.</span>
				</figcaption>
			</figure>
		</div>
	</section>

	<div class="gab-divider gab-divider--secondary" aria-hidden="true"></div>

	<section class="gab-faq">
		<p class="gab-showcase__eyebrow">Vos questions</p>
		<h2 class="gab-showcase__title">Foire aux questions</h2>

		<div class="gab-faq__list">
			<details class="gab-faq__item">
				<summary>Qui peut s'inscrire au recensement ?</summary>
				<p>
					Tout ressortissant gabonais établi en Zone Afrique peut s'inscrire. Le dispositif est
					actuellement déployé en phase pilote au Bénin et s'étendra progressivement aux autres pays de la zone.
				</p>
			</details>
			<details class="gab-faq__item">
				<summary>L'inscription est-elle payante ?</summary>
				<p>
					Non, l'inscription au recensement de la diaspora gabonaise est entièrement gratuite.
				</p>
			</details>
			<details class="gab-faq__item">
				<summary>Combien de temps prend l'inscription ?</summary>
				<p>
					Quelques minutes suffisent. Le formulaire se déroule en deux étapes&nbsp;: vos informations
					d'identité, puis votre situation d'étudiant, de salarié ou d'entrepreneur.
				</p>
			</details>
			<details class="gab-faq__item">
				<summary>Quels documents dois-je préparer ?</summary>
				<p>
					Un document d'identité (passeport, carte de résident ou carte consulaire), ainsi qu'un
					justificatif selon votre profil&nbsp;: diplôme pour un étudiant, CV pour un salarié, ou
					plan d'affaires pour un entrepreneur.
				</p>
			</details>
			<details class="gab-faq__item">
				<summary>Que se passe-t-il après ma soumission ?</summary>
				<p>
					Vous recevez immédiatement un e-mail de confirmation avec la référence de votre dossier, et
					le Bureau Exécutif de l'AGB est notifié de votre inscription.
				</p>
			</details>
			<details class="gab-faq__item">
				<summary>Mes données personnelles sont-elles protégées ?</summary>
				<p>
					Oui. Vos données sont traitées par l'Association de la Diaspora Gabonaise, conservées pendant
					5 ans, et vous disposez à tout moment de vos droits d'accès, de rectification et d'effacement.
					Consultez notre <a href="{{ path('privacy_policy') }}">politique de confidentialité</a> pour en savoir plus.
				</p>
			</details>
		</div>
	</section>

	<div class="gab-divider gab-divider--tertiary" aria-hidden="true"></div>
{% endblock %}
