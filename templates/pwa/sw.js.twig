// Service worker minimal : ne fait aucune mise en cache, sert uniquement à
// satisfaire les critères d'installabilité PWA de Chrome/Android
// (l'événement "beforeinstallprompt" ne se déclenche que si un service worker
// avec un gestionnaire "fetch" est enregistré).
self.addEventListener('install', () => {
    self.skipWaiting();
});

self.addEventListener('activate', (event) => {
    event.waitUntil(self.clients.claim());
});

self.addEventListener('fetch', (event) => {
    // Les requêtes de préchargement (ex. <link rel="modulepreload"> généré par
    // AssetMapper) arrivent avec cache "only-if-cached" + mode "no-cors" ; un
    // simple fetch(event.request) les relaie telles quelles, ce que fetch()
    // refuse ("'only-if-cached' can be set only if 'mode' is 'same-origin'").
    // On laisse alors le navigateur gérer la requête nativement.
    if (event.request.cache === 'only-if-cached' && event.request.mode !== 'same-origin') {
        return;
    }

    event.respondWith(fetch(event.request));
});
